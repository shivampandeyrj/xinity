{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xinity",
  "compatibility_date": "2026-08-09",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "xinity.in",
      "custom_domain": true
    },
    {
      "pattern": "www.xinity.in",
      "custom_domain": true
    }
  ]
}
